# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Chrome profiles for Instagram accounts (browser-launcher)
/chrome-profiles

# Service account keys
/secrets

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.zip

# Local scratch — one-shot scripts and their dumps. tmp-e2e alone reached
# ~100 MB of scraped samples, so `git add .` from DEPLOY.md would push it
# straight past GitHub's file size limit and bloat the repo permanently.
/tmp-e2e
/tmp-ig
tmp-*.mjs
tmp-*.js

# Local source images for import-pose-library.ts — never committed, especially
# once nsfw/ has anything in it.
/pose-import

# Scraped prompt corpora (~50 MB) — source data for the DB importers, not
# something the app reads at runtime.
/prompts

# Editor / tooling local state
/.cursor
__pycache__/

# Local WaveSpeed history dumps (scripts/wavespeed-archive.ts)
/wavespeed-archive
/wavespeed-archive.zip
