# Copy to .env.local on the server. Never commit real values.

# ── Core ──────────────────────────────────────────────────────
DATABASE_URL=
FANVUE_SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=
NEXT_PUBLIC_BASE_URL=https://xxmachine.com
PORT=3000

# ── AI / generation ───────────────────────────────────────────
WAVESPEED_API_KEY=
HF_TOKEN=
XAI_API_KEY=
APIFY_API_KEY=
# Platform-wide fallback for Instagram scraping when Apify is unavailable
# (per-user keys set in Settings take precedence).
RAPIDAPI_KEY=

# ── Storage ───────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Instagram ─────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://xxmachine.com/api/instagram/oauth/callback

# ── Threads ───────────────────────────────────────────────────
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://xxmachine.com/api/threads/oauth/callback

# ── Google Drive ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://xxmachine.com/api/google/callback

# ── Fanvue (owner-only, gated by OWNER_EMAIL) ─────────────────
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_REDIRECT_URI=https://xxmachine.com/api/fanvue/callback
# Only this account sees the Fanvue sidebar section / can call its API routes —
# independent of `role`, so other admins are excluded too.
OWNER_EMAIL=

# ── Telegram scheduling + monitor alerts ─────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_GROUP_ID=
# Optional fallback if user has not linked via /start (your personal chat id)
TELEGRAM_MONITOR_CHAT_ID=

# ── Payments (Bybit) ──────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_MERCHANT_ID=
PRICE_STARTER_USDT=29
PRICE_PRO_USDT=69
PRICE_AGENCY_USDT=149

# ── Optional server-only ──────────────────────────────────────
# FFMPEG_PATH=/usr/bin/ffmpeg
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome

# ── My Pod (Fish API key is pasted in UI → Connection, not here) ──
# MY_POD_SSH_PRIVATE_KEY=   # or place key at /root/.ssh/runpod_ed25519
# MY_POD_PYTHON=python3
# FISH_MODEL=s2-pro

# ── Viral IG monitor (isolated daily job, src/lib/viral-monitor) ──
# Sheet ID from its URL; share the sheet with the service account in
# secrets/google-service-account.json (Viewer) and enable the Sheets API on
# that GCP project.
VIRAL_MONITOR_SHEET_ID=
# VIRAL_MONITOR_SHEET_RANGE=Sheet1!A2:A
# Output tab in the same spreadsheet — mirrors viral_monitor_videos (views,
# followers, dates). Created automatically if missing.
# VIRAL_MONITOR_REPORT_SHEET_NAME=Videos
# VIRAL_MONITOR_REELS_PER_PROFILE=5
# VIRAL_MONITOR_VIEWS_THRESHOLD=100000
# VIRAL_MONITOR_WINDOW_DAYS=5
# A video also qualifies when views >= followers * this (OR'd with the flat
# threshold above, not a replacement).
# VIRAL_MONITOR_FOLLOWERS_MULTIPLIER=10
# Falls back to TELEGRAM_MONITOR_CHAT_ID / TELEGRAM_ADMIN_GROUP_ID if unset.
# VIRAL_MONITOR_TELEGRAM_CHAT_ID=
# Own dedicated bot token (from @BotFather) — deliberately separate from the
# shared TELEGRAM_BOT_TOKEN, same reasoning as TELEGRAM_RECREATE_BOT_TOKEN.
# The chat above must message this bot once (e.g. /start) before it can DM it.
VIRAL_MONITOR_TELEGRAM_BOT_TOKEN=
