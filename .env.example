# Copy to .env.local on the server. Never commit real values.

# ── Core ──────────────────────────────────────────────────────
DATABASE_URL=
FANVUE_SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=
NEXT_PUBLIC_BASE_URL=https://xxmachine.com
PORT=3000

# ── AI / generation ───────────────────────────────────────────
WAVESPEED_API_KEY=
HF_TOKEN=
XAI_API_KEY=
APIFY_API_KEY=
# Platform-wide fallback for Instagram scraping when Apify is unavailable
# (per-user keys set in Settings take precedence).
RAPIDAPI_KEY=

# ── Storage ───────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Instagram ─────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://xxmachine.com/api/instagram/oauth/callback

# ── Threads ───────────────────────────────────────────────────
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://xxmachine.com/api/threads/oauth/callback

# ── Google Drive ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://xxmachine.com/api/google/callback

# ── Fanvue (optional — being removed from UI) ─────────────────
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_REDIRECT_URI=https://xxmachine.com/api/fanvue/callback

# ── Telegram scheduling + monitor alerts ─────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_GROUP_ID=
# Optional fallback if user has not linked via /start (your personal chat id)
TELEGRAM_MONITOR_CHAT_ID=

# ── Payments (Bybit) ──────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_MERCHANT_ID=
PRICE_STARTER_USDT=29
PRICE_PRO_USDT=69
PRICE_AGENCY_USDT=149

# ── Optional server-only ──────────────────────────────────────
# FFMPEG_PATH=/usr/bin/ffmpeg
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome

# ── My Pod (Fish API key is pasted in UI → Connection, not here) ──
# MY_POD_SSH_PRIVATE_KEY=   # or place key at /root/.ssh/runpod_ed25519
# MY_POD_PYTHON=python3
# FISH_MODEL=s2-pro
