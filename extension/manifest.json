{
  "manifest_version": 3,
  "name": "XXmachine Clipper",
  "version": "1.1.0",
  "description": "Save any image from any site straight into XXmachine's Pinterest / Browser Clips library.",
  "permissions": ["storage", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://chrome.google.com/webstore/*", "*://chromewebstore.google.com/*"],
      "js": ["image-url.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "XXmachine Clipper"
  },
  "options_page": "options.html"
}
